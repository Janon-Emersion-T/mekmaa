APP_ENV=development
ADDR=:8080
DB_PATH=./app.db
UPLOAD_DIR=./data/uploads
COOKIE_SECURE=false
MEKMAA_PUBLIC_BASE_URL=http://localhost:8080
BOOKING_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
BOOKING_ACCESS_TOKEN_TTL_DAYS=180

BOOKING_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=bookings@example.com

BOOKING_SMS_ENABLED=false
SMS_USER_ID=replace-with-sms-user-id
SMS_API_KEY=replace-with-sms-api-key
SMS_SENDER_ID=MEKMAA

MEKMAA_CONTACT_PHONE=0770000000
MEKMAA_CONTACT_EMAIL=bookings@example.com
MEKMAA_VENUE_NAME=Mekmaa
MEKMAA_VENUE_ADDRESS=No. 64, Temple Road, Jaffna 40000, Sri Lanka
